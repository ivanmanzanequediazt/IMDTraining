{
  "name": "IMDTraining",
  "short_name": "IMDTraining",
  "description": "Frecuencia cardíaca, fuerza, carga de entrenamiento y test.",
  "lang": "es",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0E150F",
  "theme_color": "#0E150F",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "files",
          "accept": ["application/json", ".json", "text/plain", ".txt", "application/octet-stream", "*/*"]
        }
      ]
    }
  }
}
